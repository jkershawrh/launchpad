FROM registry.access.redhat.com/ubi9/python-311:latest  # TODO: pin to specific version

LABEL name="partner-ai-launchpad-backend" \
      version="0.1.0" \
      description="Partner AI Launchpad — Backend API"

WORKDIR /opt/app-root/src

USER 0
RUN curl -sL https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable/openshift-client-linux.tar.gz \
    | tar xz -C /usr/local/bin oc kubectl \
    && chmod +x /usr/local/bin/oc /usr/local/bin/kubectl \
    && curl -sL https://get.helm.sh/helm-v3.17.3-linux-amd64.tar.gz \
    | tar xz -C /usr/local/bin --strip-components=1 linux-amd64/helm \
    && chmod +x /usr/local/bin/helm

RUN pip install --no-cache-dir pydantic pyyaml fastapi uvicorn httpx sqlalchemy asyncpg psycopg2-binary kubernetes requests "celery[redis]" kafka-python-ng

COPY backend/app/ ./app/
COPY backend/celery_app.py ./celery_app.py
COPY backend/tasks/ ./tasks/
COPY backend/scripts/ ./scripts/
COPY deploy/ /opt/deploy/
COPY demos/deploy/ /opt/demos-deploy/

# Quickstarts are optional — cloned upstream repos, not in git.
# When present, pre-build Helm chart dependencies at image build time.
COPY demos/quickstart[s]/ /opt/quickstarts/
RUN if [ -d /opt/quickstarts/rag ]; then \
      helm repo add ai-quickstart https://rh-ai-quickstart.github.io/ai-architecture-charts 2>/dev/null || true \
      && helm repo update 2>/dev/null || true \
      && cd /opt/quickstarts/rag/deploy/helm/rag && helm dependency build . 2>&1 || true \
      && cd /opt/quickstarts/llm-cpu-serving/helm && helm dependency build . 2>&1 || true; \
    else echo "Quickstarts not present — skipping Helm dependency build"; fi

USER 1001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
