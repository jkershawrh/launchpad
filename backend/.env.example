# Launchpad Configuration
# Copy to .env and fill in values for your environment

# ── Mode ─────────────────────────────────────────────────────────
# mock (default) | local | openshift | rhdp
LAUNCHPAD_MODE=mock

# ── Database (optional — falls back to in-memory) ────────────────
# DATABASE_URL=postgresql://launchpad:password@localhost:5432/launchpad

# ── RHDP Mode (required when LAUNCHPAD_MODE=rhdp) ────────────────
# SANDBOX_API_URL=https://sandbox-api.example.com
# SANDBOX_LOGIN_TOKEN=your-jwt-token
# SANDBOX_PLACEMENT_TIMEOUT=300

# ── OpenShift Mode ───────────────────────────────────────────────
# OPERATOR_NAMESPACE=partner-ai-launchpad
# OPENSHIFT_INGRESS_DOMAIN=apps.cluster.example.com

# ── Intelligence Layer (all modes) ───────────────────────────────
# ORCHESTRATION_BRAIN_ENABLED=false
# WORKLOAD_PROFILING_ENABLED=false
# FEEDBACK_TRACKING_ENABLED=false
# SMART_PLACEMENT_ENABLED=true

# ── External Integrations (optional — graceful degradation) ──────
# STARGATE_API_URL=https://stargate.example.com
# STARGATE_API_KEY=your-api-key
# STARGATE_SSL_VERIFY=true
# DEEPFIELD_API_URL=https://deepfield.example.com
# DEEPFIELD_API_KEY=your-api-key
# DASHBOARD_AUDIT_URL=https://dashboard.example.com

# ── Babylon Catalog (optional) ───────────────────────────────────
# BABYLON_KUBECONFIG=/path/to/babylon.kubeconfig

# ── LLM / MaaS (optional — used for brand generation) ────────────
# LITELLM_API_BASE=https://litellm.example.com
# LITELLM_API_KEY=your-litellm-key

# ── Authentication ───────────────────────────────────────────────
# AUTH_ENABLED=true
# API_KEYS=key1,key2
# ADMIN_API_KEYS=admin-key1

# ── Session Limits ───────────────────────────────────────────────
# MAX_ACTIVE_SESSIONS_PER_USER=2
# MAX_ACTIVE_SESSIONS_PER_TENANT=5

# ── Background Tasks ────────────────────────────────────────────
# TTL_ENFORCEMENT_INTERVAL=300

# ── CORS ─────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
