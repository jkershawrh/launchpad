FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:d1bad2a2790eac1651e57e78159a81b72ddfa7b836936b26cf51e09744bf1c2d

WORKDIR /opt/app-root/src

USER 0
RUN microdnf install -y git-core python3.11 python3.11-pip \
    && microdnf clean all \
    && python3.11 -m pip install --no-cache-dir pydantic==2.13.5 pyyaml==6.0.3

COPY backend/app/ ./app/

USER 1001

ENTRYPOINT ["python3.11", "-m", "app.catalog_intake_worker_main"]
