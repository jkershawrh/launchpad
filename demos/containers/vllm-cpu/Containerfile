# vLLM CPU Inference Container for Intel Xeon6
# Optimized for CPU-based LLM inference on OpenShift AI
# V1: Simplified version using transformers (will refactor to full vLLM)

FROM registry.access.redhat.com/ubi9/python-311:latest  # TODO: pin to specific version

# Metadata labels
LABEL org.opencontainers.image.title="vLLM CPU Inference Runtime" \
      org.opencontainers.image.description="vLLM optimized for Intel Xeon6 CPU inference" \
      org.opencontainers.image.vendor="Red Hat" \
      org.opencontainers.image.version="1.0.0-simple" \
      io.openshift.ai.runtime="vllm-cpu" \
      io.openshift.ai.hardware="xeon6"

# Set working directory
WORKDIR /opt/app-root/src

# Install system dependencies
USER 0
RUN dnf install -y \
    gcc \
    gcc-c++ \
    git \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Switch back to non-root user (UID 1001 in UBI Python images)
USER 1001

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch (CPU-only version for smaller size)
RUN pip install --no-cache-dir \
    torch==2.5.1 \
    --index-url https://download.pytorch.org/whl/cpu

# Install transformers and API dependencies
RUN pip install --no-cache-dir \
    transformers>=4.40.0 \
    accelerate>=0.29.0 \
    fastapi>=0.110.0 \
    uvicorn[standard]>=0.29.0 \
    pydantic>=2.7.0 \
    huggingface-hub>=0.23.0 \
    requests>=2.31.0 \
    sentencepiece>=0.2.0 \
    protobuf>=4.25.0

# Create directories for models and cache
RUN mkdir -p /opt/app-root/src/models /opt/app-root/src/.cache

# Set environment variables
ENV HF_HOME=/opt/app-root/src/.cache \
    TRANSFORMERS_CACHE=/opt/app-root/src/.cache \
    PYTHONUNBUFFERED=1

# Copy inference server script
COPY --chown=1001:0 inference_server.py /opt/app-root/src/
COPY --chown=1001:0 entrypoint.sh /opt/app-root/src/
RUN chmod +x /opt/app-root/src/entrypoint.sh

# Expose API port
EXPOSE 8000

# Health check endpoint (using Python instead of curl)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Use entrypoint script
# When no CMD specified, entrypoint defaults to starting inference server
ENTRYPOINT ["/opt/app-root/src/entrypoint.sh"]
