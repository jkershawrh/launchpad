FROM registry.access.redhat.com/ubi9/python-311@sha256:7b6cb58d3ff034df7b300800bd89a469d9bd2f739d43250d76b9c9e805307ab5

LABEL name="ai-sandbox" \
      version="1.0.0" \
      description="Partner AI Launchpad — AI Sandbox (MaaS Client)"

USER 0

RUN dnf upgrade -y --refresh \
    && dnf install -y \
    openssh-server \
    openssh-clients \
    git \
    vim \
    wget \
    procps-ng \
    && dnf remove -y npm nodejs nodejs-docs nodejs-full-i18n nodejs-libs \
    && dnf clean all \
    && rm -rf /var/cache/dnf

ARG KUBECTL_VERSION=v1.37.1
ARG KUBECTL_SHA256=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
RUN curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
      -o /usr/local/bin/kubectl \
    && echo "${KUBECTL_SHA256}  /usr/local/bin/kubectl" | sha256sum -c - \
    && chmod 0555 /usr/local/bin/kubectl
COPY oc-compat /usr/local/bin/oc
RUN chmod 0555 /usr/local/bin/oc

RUN ssh-keygen -A \
    && mkdir -p /run/sshd \
    && sed -i 's/#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && echo "Port 2222" >> /etc/ssh/sshd_config

RUN useradd -m -s /bin/bash lab-user \
    && passwd -l lab-user

# Install MaaS client stack — inference is remote, keep image lean
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir \
       httpx \
       openai \
       pyyaml \
       pandas \
       ipython

ARG CODE_SERVER_VERSION=4.139.1
RUN curl -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz" \
    | tar xz -C /opt \
    && ln -s "/opt/code-server-${CODE_SERVER_VERSION}-linux-amd64/bin/code-server" /usr/local/bin/code-server \
    && curl -fsSL https://registry.npmjs.org/undici/-/undici-7.29.1.tgz \
      | tar xz -C "/opt/code-server-${CODE_SERVER_VERSION}-linux-amd64/lib/vscode/node_modules/undici" --strip-components=1 \
    && grep -q '"version": "7.29.1"' "/opt/code-server-${CODE_SERVER_VERSION}-linux-amd64/lib/vscode/node_modules/undici/package.json"

COPY entrypoint.sh /opt/app-root/src/entrypoint.sh
RUN chmod +x /opt/app-root/src/entrypoint.sh

COPY guided-start.md /opt/launchpad/guided-start.md
COPY guided_start.py /usr/local/bin/launchpad-guided-start
RUN chmod 0555 /usr/local/bin/launchpad-guided-start \
    && chmod 0444 /opt/launchpad/guided-start.md

COPY playbooks/ /home/lab-user/playbooks/
RUN chown -R 0:0 /home/lab-user/playbooks && chmod -R g+r /home/lab-user/playbooks

# Ensure SSH + home writable by OpenShift random UID
RUN chmod -R g+w /run/sshd && chmod g+w /etc/ssh/sshd_config \
    && chown -R 0:0 /home/lab-user \
    && chmod -R g+rwX /home/lab-user

EXPOSE 2222 8443

ENTRYPOINT ["/opt/app-root/src/entrypoint.sh"]
